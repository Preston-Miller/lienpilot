# Anthropic API key for reply triage (both Simulate and live Send).
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Fallback clinic contact, used only if clinic_contacts.json (Clinic setup) is missing.
# CLINIC_CONTACT_NAME=Jordan Lee
# CLINIC_CONTACT_EMAIL=jordan.lee@clinic.example

# ---- Live email (Gmail) --------------------------------------------------------
# A dedicated Gmail account for the agent. Sends over SMTP; the server keeps an
# IMAP IDLE connection open so Gmail pushes new mail instantly.
# 1. Create the account and turn on 2-Step Verification.
# 2. Google Account → Security → App passwords → create one for "LienPilot".
# Leave both blank to run in Simulate-only mode.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Optional: display name on outgoing mail (default "LienPilot") and the backup
# inbox check interval on the open connection (default 60s; IDLE pushes are instant).
# LIEN_FROM_NAME=LienPilot
# GMAIL_POLL_SECONDS=60

# Optional: change the port (default 3000).
# PORT=3000
